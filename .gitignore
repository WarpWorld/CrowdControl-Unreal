# Explcitly ignore Mac DS_Store files, regardless of where they are
.DS_Store

# Ignore VS / VS Code settings directory, except the hand-maintained portable configs.
# Note: the exclusion must be ".vscode/*" rather than ".vscode" — git cannot re-include a
# file whose parent directory is itself excluded.
.vs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Generated by "Generate Project Files" — machine-specific, and the solution points into the
# ignored Intermediate/ folder, so a committed copy is broken for everyone who clones.
*.code-workspace
*.sln

# Ignore intermediate folders
Intermediate/
obj/

# Written by the editor at runtime — logs, autosaves, telemetry, crash-report and per-user
# editor config. All of it is machine-specific and regenerated on demand.
Saved/